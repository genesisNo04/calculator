<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.scene.layout.RowConstraints?>
<GridPane alignment="CENTER" xmlns:fx="http://javafx.com/fxml"
          fx:controller="org.example.calculator.CalculatorController"
          hgap="10" vgap="10">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
  </padding>

  <MFXTextField fx:id="calculateScreen" editable="false" styleClass="screen-field">
    <GridPane.rowIndex>0</GridPane.rowIndex>
    <GridPane.columnIndex>0</GridPane.columnIndex>
    <GridPane.columnSpan>3</GridPane.columnSpan>
    <GridPane.vgrow>ALWAYS</GridPane.vgrow>
    <GridPane.valignment>CENTER</GridPane.valignment>
  </MFXTextField>

  <MFXButton text="7" fx:id="seven" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>1</GridPane.rowIndex>
    <GridPane.columnIndex>0</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="8" fx:id="eight" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>1</GridPane.rowIndex>
    <GridPane.columnIndex>1</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="9" fx:id="nine" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>1</GridPane.rowIndex>
    <GridPane.columnIndex>2</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="/" fx:id="divide" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>1</GridPane.rowIndex>
    <GridPane.columnIndex>3</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="4" fx:id="four" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>2</GridPane.rowIndex>
    <GridPane.columnIndex>0</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="5" fx:id="five" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>2</GridPane.rowIndex>
    <GridPane.columnIndex>1</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="6" fx:id="six" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>2</GridPane.rowIndex>
    <GridPane.columnIndex>2</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="*" fx:id="multiply" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>2</GridPane.rowIndex>
    <GridPane.columnIndex>3</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="1" fx:id="one" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>3</GridPane.rowIndex>
    <GridPane.columnIndex>0</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="2" fx:id="two" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>3</GridPane.rowIndex>
    <GridPane.columnIndex>1</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="3" fx:id="three" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>3</GridPane.rowIndex>
    <GridPane.columnIndex>2</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="-" fx:id="minus" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>3</GridPane.rowIndex>
    <GridPane.columnIndex>3</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="0" fx:id="zero" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>4</GridPane.rowIndex>
    <GridPane.columnIndex>0</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="." fx:id="dot" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>4</GridPane.rowIndex>
    <GridPane.columnIndex>1</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="C" fx:id="clear" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>0</GridPane.rowIndex>
    <GridPane.columnIndex>3</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="=" fx:id="equal" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>4</GridPane.rowIndex>
    <GridPane.columnIndex>2</GridPane.columnIndex>
  </MFXButton>

  <MFXButton text="+" fx:id="plus" styleClass="calc-button" onAction="#handleClick">
    <GridPane.rowIndex>4</GridPane.rowIndex>
    <GridPane.columnIndex>3</GridPane.columnIndex>
  </MFXButton>

</GridPane>
